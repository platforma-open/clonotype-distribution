ll := import("@platforma-sdk/workflow-tengo:ll")
text := import("text")

// Per-instance label. Stamping it into every output column gives each instance a distinct
// trace entry, so downstream label derivation can add a suffix instead of two identical
// options. A custom label is kept verbatim; otherwise it is the block name with the native
// labels of the chosen grouping, temporal and subject columns, then the settings.
build := func(inputs, columns) {
	blockLabel := inputs.customBlockLabel
	if blockLabel == undefined || blockLabel == "" {
		labelParts := []
		for ref in [inputs.groupingColumnRef, inputs.temporalColumnRef, inputs.subjectColumnRef] {
			if ref == undefined {
				continue
			}
			annotations := columns.getSpec(ref).annotations
			label := is_undefined(annotations) ? undefined : annotations["pl7.app/label"]
			if !is_undefined(label) && label != "" {
				labelParts = append(labelParts, label)
			}
		}
		if inputs.paramsLabel != "" {
			labelParts = append(labelParts, inputs.paramsLabel)
		}
		blockLabel = "Clonotype Distribution"
		if len(labelParts) > 0 {
			blockLabel = "Clonotype Distribution (" + text.join(labelParts, ", ") + ")"
		}
	}
	return blockLabel
}

export ll.toStrict({
	build: build
})
